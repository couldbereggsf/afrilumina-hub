# Copy this file to .env and fill in real (sandbox) values. Never commit .env itself.

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-string

# --- Admin seed account (created automatically on first boot) ---
ADMIN_SEED_EMAIL=reagan@thereggsltd.com
ADMIN_SEED_PASSWORD=change-this-strong-password
ADMIN_SEED_NAME=Reagan

# --- PayPal (sandbox app from https://developer.paypal.com/dashboard/applications/sandbox) ---
PAYPAL_CLIENT_ID=sandbox-client-id
PAYPAL_CLIENT_SECRET=sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- M-Pesa / Daraja (sandbox app from https://developer.safaricom.co.ke) ---
MPESA_CONSUMER_KEY=sandbox-consumer-key
MPESA_CONSUMER_SECRET=sandbox-consumer-secret
MPESA_PASSKEY=sandbox-passkey
MPESA_SHORT_CODE=174379
MPESA_API_URL=https://sandbox.safaricom.co.ke
# For local dev, Safaricom needs a public URL to reach your callback endpoint - use an
# ngrok tunnel (e.g. https://your-tunnel.ngrok-free.app/api/mpesa/callback), not localhost.
MPESA_CALLBACK_URL=https://your-tunnel.ngrok-free.app/api/mpesa/callback

# --- CORS ---
ALLOWED_ORIGINS=https://www.afriluminahub.com,http://localhost:5173

# --- Mail (optional, for confirmation emails) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
