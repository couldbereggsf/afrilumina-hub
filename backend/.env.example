# Copy this file to .env and fill in real (sandbox) values. Never commit .env itself.

# --- JWT ---
JWT_SECRET=change-this-to-a-long-random-string

# --- Admin seed account (created automatically on first boot) ---
ADMIN_SEED_EMAIL=reagan@thereggsltd.com
ADMIN_SEED_PASSWORD=change-this-strong-password
ADMIN_SEED_NAME=Reagan

# --- Stripe (sandbox/test keys from https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_SUCCESS_URL=https://www.afriluminahub.com/payment-success
STRIPE_CANCEL_URL=https://www.afriluminahub.com/payment-cancelled

# --- PayPal (sandbox app from https://developer.paypal.com/dashboard/applications/sandbox) ---
PAYPAL_CLIENT_ID=sandbox-client-id
PAYPAL_CLIENT_SECRET=sandbox-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- CORS ---
ALLOWED_ORIGINS=https://www.afriluminahub.com,http://localhost:5173

# --- Mail (optional, for confirmation emails) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
