# This is a TEMPLATE only - do not fill in real values and commit this file.
# Create the real secret instead with, e.g.:
#
#   kubectl create secret generic afrilumina-secrets \
#     --from-literal=DB_HOST=<azure-mysql-host> \
#     --from-literal=DB_USERNAME=<db-user> \
#     --from-literal=DB_PASSWORD=<db-pass> \
#     --from-literal=JWT_SECRET=<long-random-string> \
#     --from-literal=STRIPE_SECRET_KEY=sk_test_xxx \
#     --from-literal=STRIPE_WEBHOOK_SECRET=whsec_xxx \
#     --from-literal=PAYPAL_CLIENT_ID=xxx \
#     --from-literal=PAYPAL_CLIENT_SECRET=xxx \
#     --from-literal=ADMIN_SEED_EMAIL=reagan@thereggsltd.com \
#     --from-literal=ADMIN_SEED_PASSWORD=<strong-password>
#
# For production on Azure, prefer the Azure Key Vault Provider for Secrets Store CSI Driver
# instead of plain kubectl secrets, so nothing sensitive lives in the cluster's etcd directly.

apiVersion: v1
kind: Secret
metadata:
  name: afrilumina-secrets
type: Opaque
stringData:
  DB_HOST: "REPLACE_ME"
  DB_USERNAME: "REPLACE_ME"
  DB_PASSWORD: "REPLACE_ME"
  JWT_SECRET: "REPLACE_ME"
  STRIPE_SECRET_KEY: "REPLACE_ME"
  STRIPE_WEBHOOK_SECRET: "REPLACE_ME"
  PAYPAL_CLIENT_ID: "REPLACE_ME"
  PAYPAL_CLIENT_SECRET: "REPLACE_ME"
  ADMIN_SEED_EMAIL: "REPLACE_ME"
  ADMIN_SEED_PASSWORD: "REPLACE_ME"
